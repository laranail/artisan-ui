# Normalize line endings on checkout/commit.
* text=auto eol=lf

# Dev-only paths stripped from the Composer dist tarball.
# /resources is deliberately NOT export-ignored: resources/dist holds the built
# browser bundle and stylesheet, which must ship to consumers.
/.github            export-ignore
/bin                export-ignore
/docs               export-ignore
/tests              export-ignore
/workbench          export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/package.json       export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/rector.php         export-ignore
/testbench.yaml     export-ignore
/vitest.config.js   export-ignore
/biome.json         export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore

# The source stylesheet and scripts are the input to resources/dist; only the
# built output is needed at runtime.
/resources/css      export-ignore
/resources/js       export-ignore

*.blade.php         linguist-language=Blade
/resources/dist/**  linguist-generated=true
